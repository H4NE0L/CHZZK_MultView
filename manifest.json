{
  "manifest_version": 3,
  "name": "치지직 통합관제실",
  "version": "2.0.2",
  "description": "CHZZK 방송 통합관제 시스템. 여러 방송을 한 화면에서 동시에 시청하고 관리할 수 있습니다.",
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://api.chzzk.naver.com/*",
    "https://*.naver.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_title": "치지직 통합관제실",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "src/shared/messages.js",
        "src/shared/important-chat.js",
        "src/content/chat-layout.js",
        "src/content/media-frame.js",
        "src/content/chat-collector.js",
        "src/content/chzzk-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "src/content/site-launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src https://chzzk.naver.com; connect-src https://api.chzzk.naver.com; style-src 'self'; media-src 'self' blob:;"
  },
  "minimum_chrome_version": "119",
  "web_accessible_resources": [
    {
      "resources": [
        "src/viewer/viewer.css",
        "src/shared/group-manager.css"
      ],
      "matches": [
        "https://chzzk.naver.com/*"
      ]
    }
  ]
}
