{
  "manifest_version": 3,
  "name": "CZ 통제실",
  "version": "1.1.5",
  "description": "CHZZK 방송 통합관제 시스템. 여러 방송을 한 화면에서 동시에 시청하고 관리할 수 있습니다.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://api.chzzk.naver.com/*",
    "https://*.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CZ 통제실",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "chzzk-page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "chzzk-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
